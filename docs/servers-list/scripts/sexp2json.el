;; usage: emacs --batch -l sexp2json.el FILE HEADS... -> JSON lines of matching forms (recursive)
(require 'cl-lib)
(defun j-str (s) (concat "\"" (replace-regexp-in-string "[\"\\\\\n\t\r[:cntrl:]]" (lambda (m) (pcase m ("\"" "\\\"") ("\\" "\\\\") ("\n" "\\n") ("\t" "\\t") (_ (format "\\u%04x" (aref m 0))))) s t t) "\""))
(defun j (x)
  (cond ((null x) "null")
        ((eq x t) "true")
        ((stringp x) (j-str (substring-no-properties x)))
        ((integerp x) (number-to-string x))
        ((floatp x) (number-to-string x))
        ((symbolp x) (concat "{\"s\":" (j-str (symbol-name x)) "}"))
        ((vectorp x) (concat "{\"v\":[" (mapconcat #'j (append x nil) ",") "]}"))
        ((consp x)
         (if (proper-list-p x)
             (concat "[" (mapconcat #'j x ",") "]")
           (concat "{\"cons\":[" (j (car x)) "," (j (cdr x)) "]}")))
        (t (j-str (prin1-to-string x)))))
(defun walk (form heads out)
  (when (consp form)
    (when (and (symbolp (car form)) (memq (car form) heads))
      (funcall out form))
    (when (proper-list-p form)
      (dolist (f form) (walk f heads out)))
    (unless (proper-list-p form)
      (walk (car form) heads out) (walk (cdr form) heads out))))
(when command-line-args-left (let* ((args command-line-args-left)
       (file (car args))
       (heads (mapcar #'intern (cdr args))))
  (setq command-line-args-left nil)
  (with-temp-buffer
    (insert-file-contents file)
    (goto-char (point-min))
    (condition-case nil
        (while t
          (let ((form (read (current-buffer))))
            (walk form heads (lambda (f) (princ (j f)) (terpri)))))
      (end-of-file nil)
      (invalid-read-syntax (message "read error in %s at %d" file (point)))))))
