(require 'json)
(let ((exts (with-temp-buffer (insert-file-contents "cache/cand-ext.txt") (split-string (buffer-string) "\n" t)))
      (lspre (with-temp-buffer (insert-file-contents "cache/lsp-mode-regexps.txt")
               (mapcar (lambda (l) (json-read-from-string l)) (split-string (buffer-string) "\n" t))))
      (case-fold-search nil))
  (dolist (e exts)
    (let* ((fn (concat "/tmp/proj/example." e))
           (mode (let ((r nil)) (dolist (a auto-mode-alist) (when (and (not r) (stringp (car a)) (symbolp (cdr a)) (ignore-errors (string-match-p (car a) fn))) (setq r (cdr a)))) r))
           (lang (let ((r nil)) (dolist (a lspre) (when (and (not r) (ignore-errors (string-match-p (aref a 0) fn))) (setq r (aref a 1)))) r)))
      (when (or mode lang)
        (princ (json-encode (list e (and mode (symbol-name mode)) lang))) (terpri)))))
