   "helper": "custom",
   "source": "async (file, ctx) => {\n    const files = Filesystem.up({\n      targets: [\"deno.json\", \"deno.jsonc\"],\n      start: path.dirname(file),\n      stop: ctx.directory,\n    })\n    const first = await files.next()\n    await files.return()\n    if (!first.value) return undefined\n    return path.dirname(first.value)\n  }",
