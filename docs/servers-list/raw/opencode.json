  "source": "opencode",
  "export_name": "RustAnalyzer",
  "server_id": "rust",
  "root": {
   "helper": "custom",
   "source": "async (file, ctx) => {\n    const crateRoot = await NearestRoot([\"Cargo.toml\", \"Cargo.lock\"])(file, ctx)\n    if (crateRoot === undefined) {\n      return undefined\n    }\n    let currentDir = crateRoot\n\n    while (currentDir !== path.dirname(currentDir)) {\n      // Stop at filesystem root\n      const cargoTomlPath = path.join(currentDir, \"Cargo.toml\")\n      try {\n        const cargoTomlContent = await Filesystem.readText(cargoTomlPath)\n        if (cargoTomlContent.includes(\"[workspace]\")) {\n          return currentDir\n        }\n      } catch {\n        // File doesn't exist or can't be read, continue searching up\n      }\n\n      const parentDir = path.dirname(currentDir)\n      if (parentDir === currentDir) break // Reached filesystem root\n      currentDir = parentDir\n\n      // Stop if we've gone above the app root\n      if (!currentDir.startsWith(ctx.worktree)) break\n    }\n\n    return crateRoot\n  }",
   "string_literals": [
    "Cargo.toml",
    "Cargo.lock",
    "[workspace]"
   ]
  },
  "extensions": [
   ".rs"
  ],
  "spawn_calls": [
   {
    "callee": "which",
    "args": [
     "rust-analyzer"
    ]
   },
   {
    "callee": "spawn",
    "args": [
     null,
     null
    ]
   }
  ],
  "spawn_string_literals": [
   "rust-analyzer"
